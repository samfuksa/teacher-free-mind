<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. ZÁKAZ HTTP: Automatické vynucení a přesměrování na HTTPS (kód 301)
    RewriteCond %{HTTPS} off [OR]
    RewriteCond %{HTTP:X-Forwarded-Proto} =http [OR]
    RewriteCond %{HTTP:X-Forwarded-SSL} =off
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # 2. Povolit přímý přístup k API skriptům v /api/
    RewriteRule ^api/ - [L]

    # 3. Pokud soubor nebo adresář existuje, servírovat jej přímo
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 4. Všechny ostatní požadavky nasměrovat na index.html (SPA routing)
    RewriteRule ^ index.html [L]
</IfModule>

# Zabezpečení HSTS (Strict-Transport-Security)
<IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
</IfModule>

# Zapnutí gzip komprese
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/plain text/html text/xml text/css application/xml application/xhtml+xml application/rss+xml application/javascript application/x-javascript application/json
</IfModule>
